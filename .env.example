# NexuPay - Variables de Entorno
# Copia este archivo a .env y completa los valores reales

# === CONFIGURACIÓN DE SUPABASE ===
VITE_SUPABASE_URL=tu_supabase_url_aqui
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# === CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL ===
# Groq AI (para Módulo Conversacional)
VITE_GROQ_API_KEY=tu_groq_api_key_aqui

# Chutes AI (opcional)
VITE_CHUTES_API_KEY=tu_chutes_api_key_aqui

# === CONFIGURACIÓN DE EMAIL ===
# SendGrid (servicio de email por defecto)
VITE_SENDGRID_API_KEY=tu_sendgrid_api_key_aqui

# Mailgun (opcional)
VITE_MAILGUN_API_KEY=tu_mailgun_api_key_aqui
VITE_MAILGUN_DOMAIN=tu_mailgun_domain_aqui

# Amazon SES (opcional)
VITE_AWS_SES_ACCESS_KEY_ID=tu_aws_ses_access_key_aqui
VITE_AWS_SES_SECRET_ACCESS_KEY=tu_aws_ses_secret_access_key_aqui
VITE_AWS_SES_REGION=tu_aws_ses_region_aqui

# === CONFIGURACIÓN DE MERCADO PAGO ===
# Credenciales de Mercado Pago para procesamiento de pagos
VITE_MERCADOPAGO_PUBLIC_KEY=tu_mercadopago_public_key_aqui
VITE_MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token_aqui
VITE_MERCADOPAGO_SANDBOX=true

# === CONFIGURACIÓN DE DESARROLLO ===
# Entorno de la aplicación
NODE_ENV=development

# Puerto de desarrollo (opcional)
PORT=3002

# === NOTAS IMPORTANTES ===
# 1. Las variables que empiezan con VITE_ están disponibles en el frontend
# 2. Las credenciales por defecto están configuradas en src/config/systemConfig.js
# 3. En producción, usa variables de entorno para mayor seguridad
# 4. Nunca commits el archivo .env con credenciales reales
